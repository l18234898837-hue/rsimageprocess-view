# 平台本地运行端口号
VITE_PORT = 8848

# 开发环境读取配置文件路径
# VITE_API_PATH = /wxApi  #本地机房
# VITE_API_PATH = http://192.168.2.201/api  #本地机房
VITE_API_PATH = http://127.0.0.1:8080  #本地开发后端

VITE_MAPSOURE_PATH = /gdMap  #本地地图瓦片通过 Vite 代理转发到 9000 静态服务
